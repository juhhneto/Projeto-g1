import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from IPython.display import display, Markdown

sns.set_theme(style="whitegrid", context="notebook", palette="crest")

plt.rcParams.update({
    "figure.figsize": (10, 5),
    "figure.dpi": 120,
    "savefig.dpi": 160,
    "axes.titlesize": 14,
    "axes.titleweight": "bold",
    "axes.labelsize": 11,
    "xtick.labelsize": 9,
    "ytick.labelsize": 9,
    "legend.fontsize": 9,
    "figure.facecolor": "white",
    "axes.facecolor": "white"
})

URL = (
    "https://raw.githubusercontent.com/AlexandreLouzada/"
    "Dados-Simulados-G2/main/datasets_g2_30_temas/"
    "simulacao_mobilidade_urbana_brasil.csv"
)

# 1. Leitura dos dados
try:
    df = pd.read_csv(
        "../dados/simulacao_mobilidade_urbana_brasil.csv",
        encoding="utf-8-sig"
    )
    print("Base carregada do diretório local.")
except FileNotFoundError:
    df = pd.read_csv(URL, encoding="utf-8-sig")
    print("Base carregada do GitHub.")

# 2. Limpeza e preparação
df.columns = (
    df.columns
    .str.replace("\ufeff", "", regex=False)
    .str.strip()
)

df = df.drop_duplicates().copy()
df["data"] = pd.to_datetime(df["data"], errors="coerce")

colunas_texto = [
    "regiao", "uf", "cidade",
    "meio_transporte", "nivel_congestionamento"
]

for coluna in colunas_texto:
    df[coluna] = df[coluna].astype("string").str.strip()

colunas_numericas = [
    "passageiros",
    "tempo_medio_deslocamento",
    "lotacao_media",
    "velocidade_media",
    "emissao_co2",
    "tarifa_media"
]

for coluna in colunas_numericas:
    df[coluna] = pd.to_numeric(df[coluna], errors="coerce")

print(f"Registros: {len(df):,}")
print(f"Colunas: {len(df.columns)}")
print(f"Valores ausentes: {df.isna().sum().sum():,}")

display(df.head().round(2))
display(df.describe().T.round(2))

# 3. Engenharia de atributos
ordem = ["Baixo", "Médio", "Alto", "Crítico"]

df["nivel_congestionamento"] = pd.Categorical(
    df["nivel_congestionamento"],
    categories=ordem,
    ordered=True
)

df["indice_congestionamento"] = (
    df["nivel_congestionamento"].cat.codes + 1
).replace(0, np.nan)

df["congestionado"] = df["indice_congestionamento"] >= 3

df["emissao_por_mil_passageiros"] = (
    df["emissao_co2"]
    .div(df["passageiros"].where(df["passageiros"] > 0))
    * 1000
)

df["trimestre"] = df["data"].dt.quarter

display(df[[
    "indice_congestionamento",
    "congestionado",
    "emissao_por_mil_passageiros",
    "trimestre"
]].head().round(2))

# 4. Distribuição das variáveis
variaveis = [
    "passageiros",
    "tempo_medio_deslocamento",
    "lotacao_media",
    "velocidade_media",
    "emissao_co2",
    "tarifa_media"
]

fig, axes = plt.subplots(2, 3, figsize=(15, 8))
fig.suptitle(
    "Distribuição das variáveis de mobilidade urbana",
    fontsize=17,
    fontweight="bold",
    y=1.02
)

for ax, coluna in zip(axes.flat, variaveis):
    sns.histplot(
        data=df,
        x=coluna,
        bins=25,
        kde=True,
        color="#2a9d8f",
        ax=ax
    )
    ax.set_title(coluna.replace("_", " ").title())
    ax.set_xlabel("")
    ax.set_ylabel("Frequência")

plt.tight_layout()
plt.show()

# 5. Análise por meio de transporte
resumo_transporte = (
    df.groupby("meio_transporte", observed=True)
    ["tempo_medio_deslocamento"]
    .mean()
    .dropna()
    .sort_values()
)

fig, ax = plt.subplots(figsize=(10, 5))

sns.barplot(
    x=resumo_transporte.values,
    y=resumo_transporte.index,
    color="#2a9d8f",
    ax=ax
)

ax.set_title("Tempo médio de deslocamento por transporte")
ax.set_xlabel("Tempo médio (minutos)")
ax.set_ylabel("Meio de transporte")

for i, valor in enumerate(resumo_transporte.values):
    ax.text(valor, i, f" {valor:.1f}", va="center", fontsize=10)

plt.tight_layout()
plt.show()

# 6. Comparação entre regiões
fig, ax = plt.subplots(figsize=(10, 5))

sns.boxplot(
    data=df,
    x="regiao",
    y="tempo_medio_deslocamento",
    color="#8ecae6",
    showfliers=False,
    ax=ax
)

ax.set_title("Distribuição do tempo de deslocamento por região")
ax.set_xlabel("Região")
ax.set_ylabel("Tempo de deslocamento (minutos)")

plt.tight_layout()
plt.show()

# 7. Evolução temporal dos passageiros
serie = (
    df.dropna(subset=["data", "passageiros"])
    .assign(
        mes_ref=lambda x: (
            x["data"].dt.to_period("M").dt.to_timestamp()
        )
    )
    .groupby("mes_ref")["passageiros"]
    .mean()
    .sort_index()
)

media_movel = serie.rolling(12, min_periods=3).mean()

fig, ax = plt.subplots(figsize=(13, 5))

ax.plot(
    serie.index,
    serie.values,
    color="#8ecae6",
    alpha=0.65,
    linewidth=1.2,
    label="Média mensal"
)

ax.plot(
    media_movel.index,
    media_movel.values,
    color="#e76f51",
    linewidth=2.5,
    label="Média móvel de 12 meses"
)

ax.set_title("Evolução mensal da média de passageiros por registro")
ax.set_xlabel("Data")
ax.set_ylabel("Passageiros por registro")
ax.legend()
ax.grid(alpha=0.25)

plt.tight_layout()
plt.show()

# 8. Congestionamento por meio de transporte
tabela = pd.crosstab(
    df["meio_transporte"],
    df["nivel_congestionamento"],
    normalize="index"
).mul(100)

tabela = tabela.reindex(columns=ordem, fill_value=0)

cores = ["#90be6d", "#f9c74f", "#f8961e", "#d62828"]

ax = tabela.plot(
    kind="barh",
    stacked=True,
    figsize=(11, 6),
    color=cores,
    width=0.75
)

ax.set_title("Distribuição percentual do congestionamento por transporte")
ax.set_xlabel("Registros (%)")
ax.set_ylabel("Meio de transporte")
ax.legend(
    title="Congestionamento",
    bbox_to_anchor=(1.02, 1),
    loc="upper left"
)
ax.set_xlim(0, 100)

plt.tight_layout()
plt.show()

# 9. Matriz de correlação
colunas_corr = variaveis + [
    "indice_congestionamento",
    "emissao_por_mil_passageiros"
]

correlacao = df[colunas_corr].corr()

fig, ax = plt.subplots(figsize=(11, 8))

sns.heatmap(
    correlacao,
    annot=True,
    fmt=".2f",
    cmap="coolwarm",
    center=0,
    vmin=-1,
    vmax=1,
    linewidths=0.5,
    square=True,
    ax=ax
)

ax.set_title("Matriz de correlação de Pearson", pad=16)
plt.xticks(rotation=40, ha="right")
plt.yticks(rotation=0)
plt.tight_layout()
plt.show()

# 10. KPIs
kpis = {
    "Registros": f"{len(df):,}".replace(",", "."),
    "Passageiros (milhões)": f"{df['passageiros'].sum() / 1e6:,.2f}",
    "Tempo médio": f"{df['tempo_medio_deslocamento'].mean():.1f} min",
    "Velocidade média": f"{df['velocidade_media'].mean():.1f} km/h",
    "Tarifa média": f"R$ {df['tarifa_media'].mean():.2f}",
    "Alto/Crítico": f"{df['congestionado'].mean() * 100:.1f}%"
}

fig, axes = plt.subplots(2, 3, figsize=(14, 4.8))
fig.suptitle(
    "Indicadores-chave de mobilidade urbana",
    fontsize=17,
    fontweight="bold"
)

for ax, (titulo, valor) in zip(axes.flat, kpis.items()):
    ax.set_facecolor("#f0f7f6")

    ax.text(
        0.5, 0.60, valor,
        ha="center",
        va="center",
        fontsize=19,
        fontweight="bold",
        color="#264653",
        transform=ax.transAxes
    )

    ax.text(
        0.5, 0.25, titulo,
        ha="center",
        va="center",
        fontsize=10,
        color="#457b75",
        transform=ax.transAxes
    )

    ax.set_xticks([])
    ax.set_yticks([])

    for spine in ax.spines.values():
        spine.set_visible(False)

plt.tight_layout()
plt.show()

# 11. Resumo por transporte
display(
    df.groupby("meio_transporte", observed=True)[variaveis]
    .mean()
    .round(2)
)

# 12. Resumo por região
display(
    df.groupby("regiao", observed=True)[variaveis]
    .mean()
    .round(2)
)

# 13. Distribuição do congestionamento
display(
    df["nivel_congestionamento"]
    .value_counts(normalize=True)
    .mul(100)
    .round(2)
    .rename("Percentual (%)")
    .to_frame()
)

# 14. Conclusão automática
display(Markdown("""
## Conclusão

A análise apresenta indicadores de passageiros, tempo de deslocamento,
velocidade, tarifas e congestionamento, além de comparações entre
regiões e meios de transporte.

Como a base utilizada é simulada, os resultados são adequados para
fins didáticos e não representam necessariamente a realidade da
mobilidade urbana brasileira. As conclusões devem ser interpretadas
com base nos resultados efetivamente obtidos durante a execução.
"""))
