            "\n",
            "fig, ax = plt.subplots(figsize=(13, 5))\n",
            "ax.plot(serie.index, serie.values, color='#8ecae6', alpha=0.7, label='Média mensal')\n",
            "ax.plot(media_movel.index, media_movel.values, color='#e76f51', linewidth=2.5, label='Média móvel de 12 meses')\n",
            "ax.set_title('Evolução mensal da média de passageiros por registro')\n",
            "ax.set_xlabel('Data')\n",
            "ax.set_ylabel('Passageiros por registro')\n",
            "ax.legend()\n",
