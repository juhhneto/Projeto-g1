        "cell_type": "code",
        "execution_count": None,
        "metadata": {},
        "outputs": [],
        "source": [
            "ordem = ['Baixo', 'Médio', 'Alto', 'Crítico']\n",
            "df['nivel_congestionamento'] = pd.Categorical(df['nivel_congestionamento'], categories=ordem, ordered=True)\n",
            "df['indice_congestionamento'] = (df['nivel_congestionamento'].cat.codes + 1).replace(0, np.nan)\n",
            "df['congestionado'] = df['indice_congestionamento'] >= 3\n",
            "df['emissao_por_mil_passageiros'] = df['emissao_co2'].div(df['passageiros'].where(df['passageiros'] > 0)) * 1000\n",
            "df['trimestre'] = df['data'].dt.quarter\n",
