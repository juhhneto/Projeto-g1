            "    ax.set_facecolor('#f0f7f6')\n",
            "    texto = f'{valor:,.2f}' if isinstance(valor, (int, float, np.number)) else str(valor)\n",
            "    ax.text(0.5, 0.58, texto, ha='center', va='center', fontsize=19, fontweight='bold', color='#264653', transform=ax.transAxes)\n",
            "    ax.text(0.5, 0.25, titulo, ha='center', va='center', fontsize=10, color='#457b75', transform=ax.transAxes)\n",
            "    ax.set_xticks([])\n",
            "    ax.set_yticks([])\n",
            "    for spine in ax.spines.values():\n",
            "        spine.set_visible(False)\n",
