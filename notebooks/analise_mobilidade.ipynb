        "source": [
            "serie = (df.dropna(subset=['data', 'passageiros'])\n",
            "         .assign(mes_ref=lambda x: x['data'].dt.to_period('M').dt.to_timestamp())\n",
            "         .groupby('mes_ref')['passageiros'].mean().sort_index())\n",
